<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="126dp"
    android:layout_marginEnd="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:id="@+id/promo_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/promo_copy"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/promo_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/surface_white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/promo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textColor="@color/surface_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promo_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="#D7FFF0"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/promo_action"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="5dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="10sp"
                app:backgroundTint="@color/surface_white"
                app:cornerRadius="14dp"
                android:elevation="0dp"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/promo_illustration"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-4dp"
            android:contentDescription=""
            android:scaleType="centerInside" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
