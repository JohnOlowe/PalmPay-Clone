<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="148dp"
    app:cardBackgroundColor="@color/promo_surface"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:id="@+id/promo_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <LinearLayout
            android:id="@+id/promo_copy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="9dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/promo_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/brand_purple"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="@color/ink"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/promo_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/earnings_positive"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promo_amount_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:textColor="@color/ink_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/promo_action"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_promo_action"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/promo_illustration"
            android:layout_width="38dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|end"
            android:contentDescription=""
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
