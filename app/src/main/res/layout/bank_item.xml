<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/transfer_surface"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <ImageView
        android:id="@+id/bank_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_recipient_circle"
        android:clipToOutline="true"
        android:contentDescription=""
                android:scaleType="centerCrop"
        android:src="@drawable/ic_bank_building"
        android:tint="@color/transfer_hint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bank_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bank_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/transfer_hint"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
