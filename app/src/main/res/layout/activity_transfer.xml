<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transfer_background">

    <LinearLayout
        android:id="@+id/transfer_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/transfer_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/transfer_back_button"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="0dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:id="@+id/transfer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:includeFontPadding="false"
            android:text="@string/transfer_to_bank"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/transfer_support_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_support"
            android:padding="4dp"
            android:src="@drawable/ic_headset"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/transfer_history_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_history"
            android:padding="3dp"
            android:src="@drawable/ic_transfer_notes"
            android:tint="@color/ink" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/transfer_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/transfer_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/transfer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/free_transfer_banner"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_free_banner"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/free_label"
                    android:textColor="@color/free_banner_label"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/free_transfer_message"
                    android:textColor="@color/free_banner_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/transfer_form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:id="@+id/transfer_protection_button"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="2dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription=""
                            android:src="@drawable/exact_shield_check"
                            android:tint="@color/transfer_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:includeFontPadding="false"
                            android:text="@string/add_extra_transfer_protection"
                            android:textColor="@color/transfer_green"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/transfer_green" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/account_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_transfer_field"
                        android:minHeight="82dp"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/recipient_account"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/account_input_shell"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="8dp">

                            <EditText
                                android:id="@+id/account_number_input"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="@string/account_number_hint"
                                android:includeFontPadding="false"
                                android:inputType="number"
                                android:maxLength="12"
                                android:paddingStart="0dp"
                                android:paddingEnd="32dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:singleLine="true"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/transfer_hint"
                                android:textSize="15sp" />

                            <ImageButton
                                android:id="@+id/clear_account_button"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center_vertical|end"
                                android:background="@android:color/transparent"
                                android:contentDescription="Clear account number"
                                android:padding="0dp"
                                android:src="@drawable/exact_clear_circle"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/account_suggestions_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/bank_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_transfer_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/bank"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="8dp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/selected_bank_logo"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_recipient_circle"
                                    android:clipToOutline="true"
                                    android:contentDescription=""
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/selected_bank_text"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:includeFontPadding="false"
                                    android:text="@string/select_bank"
                                    android:textColor="@color/transfer_hint"
                                    android:textSize="15sp" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription=""
                                    android:src="@drawable/ic_chevron_right"
                                    android:tint="@color/transfer_hint" />
                            </LinearLayout>

                            <View
                                android:id="@+id/bank_extra_divider"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:background="@color/transfer_divider"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/bank_status_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ProgressBar
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:indeterminate="true" />

                                <TextView
                                    android:id="@+id/bank_status_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:includeFontPadding="false"
                                    android:textColor="@color/ink_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/matching_banks_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>

                    <include
                        android:id="@+id/recipient_confirmation_item"
                        layout="@layout/recipient_confirmation_item"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/invalid_account_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_invalid_account"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_clear_circle"
                            android:tint="#D93030" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="@string/invalid_account_notice"
                            android:textColor="#D93030"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/next_button"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_transfer_next"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/next"
                        android:textColor="@color/transfer_next_text_disabled"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/transfer_shortcuts_card"
                android:layout_width="match_parent"
                android:layout_height="87dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/transfer_shortcuts_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recent_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/transfer_tabs_inline"
                        layout="@layout/transfer_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="54dp" />

                    <LinearLayout
                        android:id="@+id/recipients_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/view_all_button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/view_all"
                        android:textColor="@color/ink_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/transfer_tabs_sticky"
        layout="@layout/transfer_tabs"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transfer_toolbar" />
</androidx.constraintlayout.widget.ConstraintLayout>
