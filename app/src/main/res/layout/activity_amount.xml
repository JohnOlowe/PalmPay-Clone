<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transfer_background">

    <LinearLayout
        android:id="@+id/amount_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/transfer_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/amount_back_button"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="0dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:id="@+id/amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:includeFontPadding="false"
            android:text="@string/transfer_to_bank"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/amount_support_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_support"
            android:padding="4dp"
            android:src="@drawable/ic_headset"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/amount_history_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_history"
            android:padding="3dp"
            android:src="@drawable/ic_transfer_notes"
            android:tint="@color/ink" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/amount_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/amount_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/amount_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/amount_details_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="13dp">

                    <LinearLayout
                        android:id="@+id/amount_protection_button"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_shield_check"
                            android:tint="@color/transfer_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:includeFontPadding="false"
                            android:text="@string/add_extra_transfer_protection"
                            android:textColor="@color/transfer_green"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/transfer_green" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/amount_recipient_row"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/amount_recipient_logo"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription=""
                            android:scaleType="centerInside"
                            android:src="@drawable/recipient_smartcash" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/amount_recipient_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/amount_recipient_account"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:textColor="@color/transfer_hint"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/amount_recipient_provider"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:includeFontPadding="false"
                                    android:textColor="@color/transfer_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/amount_field"
                        android:layout_width="match_parent"
                        android:layout_height="94dp"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/bg_amount_input"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/amount"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/amount_input"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="7dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="@string/amount_hint"
                                android:imeOptions="actionDone"
                                android:includeFontPadding="false"
                                android:inputType="numberDecimal"
                                android:padding="0dp"
                                android:singleLine="true"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/transfer_hint"
                                android:textSize="22sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/transfer_divider" />
                        </LinearLayout>
                    </FrameLayout>

                    <GridLayout
                        android:id="@+id/amount_chips_grid"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="10dp"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:useDefaultMargins="false">

                        <TextView
                            android:id="@+id/chip_500"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_500"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/chip_1000"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_1000"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/chip_2000"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_2000"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1" />
                        <TextView
                            android:id="@+id/chip_5000"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_row="1"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_5000"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/chip_9999"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_row="1"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_9999"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/chip_10000"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_row="1"
                            android:background="@drawable/bg_amount_chip"
                            android:gravity="center"
                            android:text="@string/amount_10000"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp" />
                    </GridLayout>

                    <TextView
                        android:id="@+id/amount_balance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:text="@string/balance_cashbox"
                        android:textColor="@color/ink_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/note_card"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/note"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/note_input"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/note_hint"
                        android:includeFontPadding="false"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/transfer_hint"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
