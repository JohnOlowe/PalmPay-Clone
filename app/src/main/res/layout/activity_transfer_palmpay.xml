<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transfer_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pp_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/transfer_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/pp_back_button"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="0dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:includeFontPadding="false"
            android:text="@string/transfer_to_palmpay"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/pp_support_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_support"
            android:padding="4dp"
            android:src="@drawable/exact_headset"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/pp_history_button"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/transfer_history"
            android:padding="3dp"
            android:src="@drawable/ic_transfer_notes"
            android:tint="@color/ink" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/pp_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pp_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/pp_free_banner"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_free_banner"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/free_label"
                    android:textColor="@color/free_banner_label"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/free_transfer_message"
                    android:textColor="@color/free_banner_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pp_form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/pp_protection_button"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription=""
                            android:src="@drawable/exact_shield_check"
                            android:tint="@color/transfer_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:includeFontPadding="false"
                            android:text="@string/add_extra_transfer_protection"
                            android:textColor="@color/transfer_green"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/transfer_green" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pp_account_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/bg_transfer_field"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/recipient_account"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/pp_account_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:background="@android:color/transparent"
                                android:hint="@string/palmpay_account_hint"
                                android:imeOptions="actionDone"
                                android:includeFontPadding="false"
                                android:inputType="number"
                                android:padding="0dp"
                                android:singleLine="true"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/transfer_hint"
                                android:textSize="20sp" />

                            <View
                                android:id="@+id/pp_underline"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/transfer_divider"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/pp_suggestions_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/pp_clear_button"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="34dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Clear account number"
                            android:scaleType="centerInside"
                            android:src="@drawable/exact_clear_circle"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/pp_invalid_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_invalid_account"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_clear_circle"
                            android:tint="#D93030" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="@string/invalid_account_notice"
                            android:textColor="#D93030"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <include
                        android:id="@+id/pp_confirmation_item"
                        layout="@layout/recipient_confirmation_item"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/pp_next_button"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_transfer_next"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/next"
                        android:textColor="@color/transfer_next_text_disabled"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/pp_shortcuts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/transfer_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp">

                        <LinearLayout
                            android:id="@+id/pp_recent_tab"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pp_recent_tab_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/recent"
                                android:textColor="@color/brand_purple"
                                android:textSize="14sp" />

                            <View
                                android:id="@+id/pp_recent_indicator"
                                android:layout_width="24dp"
                                android:layout_height="2dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_transfer_tab_indicator" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pp_favorites_tab"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pp_favorites_tab_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/favorites"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <View
                                android:id="@+id/pp_favorites_indicator"
                                android:layout_width="24dp"
                                android:layout_height="2dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_transfer_tab_indicator"
                                android:visibility="invisible" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pp_contacts_tab"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pp_contacts_tab_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/palmpay_contacts"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />

                            <View
                                android:id="@+id/pp_contacts_indicator"
                                android:layout_width="24dp"
                                android:layout_height="2dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_transfer_tab_indicator"
                                android:visibility="invisible" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/pp_search_button"
                            android:layout_width="36dp"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:contentDescription="@string/search_contacts"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_search"
                            android:tint="@color/ink_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/transfer_divider" />

                    <LinearLayout
                        android:id="@+id/pp_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/pp_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/view_all"
                            android:textColor="@color/ink_secondary"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/ink_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
