<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transfer_background">

    <LinearLayout
        android:id="@+id/bank_picker_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/transfer_toolbar_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/bank_picker_back_button"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="0dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:id="@+id/bank_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:includeFontPadding="false"
            android:text="@string/select_bank_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bank_picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/bank_picker_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/bank_picker_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bank_search_container"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="16dp">

                <EditText
                    android:id="@+id/bank_picker_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_transfer_field"
                    android:hint="@string/bank_search_hint"
                    android:inputType="text"
                    android:paddingStart="47dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/transfer_hint"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="18dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_search"
                    android:tint="@color/ink_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/frequently_used_title"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:background="@color/transfer_field_surface"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="@string/frequently_used_bank"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />

            <GridLayout
                android:id="@+id/frequent_banks_grid"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:columnCount="3"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:rowCount="2"
                android:useDefaultMargins="false" />

            <LinearLayout
                android:id="@+id/all_banks_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/bank_alphabet_index"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="0dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:text="@string/alphabet_index"
        android:textColor="@color/ink_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bank_picker_toolbar" />

    <ProgressBar
        android:id="@+id/bank_directory_loading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="11dp"
        android:indeterminateTint="@color/brand_purple"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bank_picker_toolbar" />
</androidx.constraintlayout.widget.ConstraintLayout>
