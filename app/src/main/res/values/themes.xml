<resources>
    <style name="Base.AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand_purple</item>
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorSecondary">@color/brand_purple</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="NoActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />
</resources>
